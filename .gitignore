# ==============================================================================
# DevFlow Root .gitignore
# ==============================================================================

# OS & Editor
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Environment Variables & Secrets (Keep out of VCS)
.env
.env*.local
*.env
server/.env
client/.env
!*.env.example
!server/.env.example
!client/.env.example

# Next.js Build Outputs
.next/
client/.next/
out/
client/out/
build/
client/build/
.vercel

# Server TypeScript & Build Artifacts
dist/
server/dist/
*.tsbuildinfo
client/*.tsbuildinfo

# Prisma Generated Client
server/src/generated/
/src/generated/prisma

# Temporary & Log files
*.log
logs/
*.pid
*.seed
*.pid.lock

# AI Assistant Cache & Local Vendor Configurations
server/.agents/
server/.claude/
server/.windsurf/
skills-lock.json
server/skills-lock.json
