# ==============================================================================
# DevFlow Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development overrides.
#
# IMPORTANT DISTINCTION:
# 1. DATABASE_URL: Used INTERNALLY by the Express server container to connect to PostgreSQL.
#    - Inside Docker Compose: Uses the service hostname `postgres` (e.g. postgresql://devflow:devflow@postgres:5432/devflow)
#    - Running locally outside Docker: Uses `localhost` (e.g. postgresql://devflow:devflow@localhost:5432/devflow)
#
# 2. NEXT_PUBLIC_API_URL: Used EXTERNALLY by the user's web browser to send API requests to Express.
#    - Web browsers execute on the host client machine, so they MUST reach Express via `http://localhost:5000`.
#    - The browser can NEVER reach `http://postgres:5432` or `http://server:5000` directly.
# ==============================================================================

# Database Configuration
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow

# Server Configuration
# Internal container-to-container database connection URL
DATABASE_URL=postgresql://devflow:devflow@postgres:5432/devflow
PORT=5000
NODE_ENV=development

# Client Configuration
# Browser-accessible public API endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000
